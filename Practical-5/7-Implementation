#include <iostream>
#include <stack>
#include <queue>
using namespace std;

int precedence(char op)
{
    if(op == '+' || op == '-')
        return 1;
    if(op == '*' || op == '/')
        return 2;
    if(op == '^')
        return 3;
    return 0;
}

bool isOperator(char ch)
{
    return (ch=='+' || ch=='-' || ch=='*' || ch=='/' || ch=='^');
}

void infixToPostfix(string exp)
{
    stack<char> st;
    queue<char> output;

    for(int i=0;i<exp.length();i++)
    {
        char ch = exp[i];

        // If operand
        if(isalnum(ch))
        {
            output.push(ch);
        }

        // Left parenthesis
        else if(ch=='(')
        {
            st.push(ch);
        }

        // Right parenthesis
        else if(ch==')')
        {
            while(!st.empty() && st.top()!='(')
            {
                output.push(st.top());
                st.pop();
            }
            st.pop();
        }

        // Operator
        else if(isOperator(ch))
        {
            while(!st.empty() && 
            precedence(st.top()) >= precedence(ch))
            {
                output.push(st.top());
                st.pop();
            }

            st.push(ch);
        }
    }

    // Pop remaining operators
    while(!st.empty())
    {
        output.push(st.top());
        st.pop();
    }

    // Print postfix expression
    cout<<"Postfix Expression: ";

    while(!output.empty())
    {
        cout<<output.front();
        output.pop();
    }
}

int main()
{
    string exp;

    cout<<"Enter infix expression: ";
    cin>>exp;

    infixToPostfix(exp);

    return 0;
}
