#include <iostream>
#include <stack>
using namespace std;

void printNGE(int arr[], int n) {
    stack<int> st;

    st.push(arr[0]);

    for (int i = 1; i < n; i++) {
        int next = arr[i];

        while (!st.empty() && st.top() < next) {
            cout << st.top() << " -> " << next << endl;
            st.pop();
        }
        st.push(next);
    }

    while (!st.empty()) {
        cout << st.top() << " -> -1" << endl;
        st.pop();
    }
}

int main() {
    int n;
    cout << "Enter number of elements: ";
    cin >> n;

    int arr[n];
    cout << "Enter array elements:\n";
    for (int i = 0; i < n; i++)
        cin >> arr[i];

    printNGE(arr, n);
    return 0;
}
