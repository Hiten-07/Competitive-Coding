#include <iostream>
using namespace std;

struct Node
{
    int data;
    Node* left;
    Node* right;
};

Node* newNode(int data)
{
    Node* node=new Node();

    node->data=data;
    node->left=NULL;
    node->right=NULL;

    return node;
}

bool isMirror(Node* t1,Node* t2)
{
    // Both empty
    if(t1==NULL && t2==NULL)
        return true;

    // One empty
    if(t1==NULL || t2==NULL)
        return false;

    return (t1->data==t2->data) &&
           isMirror(t1->left,t2->right) &&
           isMirror(t1->right,t2->left);
}

int main()
{
    Node* root1=newNode(1);

    root1->left=newNode(2);
    root1->right=newNode(3);

    Node* root2=newNode(1);

    root2->left=newNode(3);
    root2->right=newNode(2);

    if(isMirror(root1,root2))
        cout<<"Trees are Mirror";
    else
        cout<<"Trees are not Mirror";

    return 0;
}
