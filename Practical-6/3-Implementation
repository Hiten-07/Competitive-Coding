#include <iostream>
#include <queue>
using namespace std;

int main()
{
    int n;

    cout<<"Enter number of elements: ";
    cin>>n;

    if(n < 3)
    {
        cout<<"Not enough elements";
        return 0;
    }

    int arr[n];

    cout<<"Enter elements:\n";

    for(int i=0;i<n;i++)
        cin>>arr[i];

    priority_queue<int> pq;

    // Insert elements
    for(int i=0;i<n;i++)
        pq.push(arr[i]);

    int first = pq.top();
    pq.pop();

    // Remove duplicates of first
    while(!pq.empty() && pq.top()==first)
        pq.pop();

    if(pq.empty())
    {
        cout<<"Less than 3 distinct elements";
        return 0;
    }

    int second = pq.top();
    pq.pop();

    // Remove duplicates of second
    while(!pq.empty() && pq.top()==second)
        pq.pop();

    if(pq.empty())
    {
        cout<<"Less than 3 distinct elements";
        return 0;
    }

    int third = pq.top();

    long long product = (long long)first * second * third;

    cout<<"Largest distinct elements are:\n";
    cout<<first<<" "<<second<<" "<<third<<endl;

    cout<<"Product = "<<product;

    return 0;
}
