#include <iostream>
#include <unordered_map>
using namespace std;

void twoSum(int arr[], int n, int target)
{
    unordered_map<int,int> mp;

    for(int i=0;i<n;i++)
    {
        int complement = target - arr[i];

        if(mp.find(complement) != mp.end())
        {
            cout<<"Pair found at indices: "
                <<mp[complement]<<" and "<<i<<endl;

            cout<<"Values: "
                <<complement<<" + "<<arr[i]
                <<" = "<<target;

            return;
        }

        mp[arr[i]] = i;
    }

    cout<<"No pair found";
}

int main()
{
    int n;

    cout<<"Enter size: ";
    cin>>n;

    int arr[n];

    cout<<"Enter elements:\n";

    for(int i=0;i<n;i++)
        cin>>arr[i];

    int target;

    cout<<"Enter target: ";
    cin>>target;

    twoSum(arr,n,target);

    return 0;
}
