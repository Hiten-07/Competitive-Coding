#include <iostream>
#include <climits>
using namespace std;

struct Node
{
    int data;
    Node* left;
    Node* right;
};

Node* newNode(int data)
{
    Node* node=new Node();

    node->data=data;
    node->left=NULL;
    node->right=NULL;

    return node;
}

bool isValidBST(Node* root,long min,long max)
{
    if(root==NULL)
        return true;

    if(root->data <= min || root->data >= max)
        return false;

    return isValidBST(root->left,min,root->data) &&
           isValidBST(root->right,root->data,max);
}

