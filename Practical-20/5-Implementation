#include <iostream>
using namespace std;

struct TrieNode
{
    TrieNode* children[26];
    bool isEnd;

    TrieNode()
    {
        isEnd=false;

        for(int i=0;i<26;i++)
            children[i]=NULL;
    }
};

TrieNode* root=new TrieNode();

// INSERT
void insert(string word)
{
    TrieNode* curr=root;

    for(char c:word)
    {
        int index=c-'a';

        if(curr->children[index]==NULL)
            curr->children[index]=new TrieNode();

        curr=curr->children[index];
    }

    curr->isEnd=true;
}

// SEARCH
bool search(string word)
{
    TrieNode* curr=root;

    for(char c:word)
    {
        int index=c-'a';

        if(curr->children[index]==NULL)
            return false;

        curr=curr->children[index];
    }

    return curr->isEnd;
}

// Check if node has children
bool isEmpty(TrieNode* node)
{
    for(int i=0;i<26;i++)
        if(node->children[i])
            return false;

    return true;
}

// DELETE
TrieNode* removeWord(TrieNode* node,string word,int depth=0)
{
    if(node==NULL)
        return NULL;

    if(depth==word.size())
    {
        if(node->isEnd)
            node->isEnd=false;

        if(isEmpty(node))
        {
            delete node;
            node=NULL;
        }

        return node;
    }

    int index=word[depth]-'a';

    node->children[index]=
    removeWord(node->children[index],word,depth+1);

    if(isEmpty(node) && node->isEnd==false)
    {
        delete node;
        node=NULL;
    }

    return node;
}

int main()
{
    insert("cat");
    insert("car");
    insert("dog");

    cout<<"Search cat: "<<search("cat")<<endl;
    cout<<"Search cow: "<<search("cow")<<endl;

    removeWord(root,"cat");

    cout<<"After deletion cat: "<<search("cat")<<endl;

    return 0;
}
